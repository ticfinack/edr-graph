<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.edgeaspect.edr-graph-tray</string>

    <key>ProgramArguments</key>
    <array>
        <string>__TRAY_PYTHON__</string>
        <string>__TRAY_SCRIPT__</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>/tmp/edr-graph-tray.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/edr-graph-tray.err</string>
</dict>
</plist>
